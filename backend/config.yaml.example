# cf-email backend config
# Copy to ./config.yaml (cwd of the running binary) and fill in.
# Override CONFIG_PATH env var if you want a different location.
# Individual fields can also be overridden by env vars
# (BIND_ADDR, PUBLIC_BASE_URL, DB_PATH, STORAGE_DIR,
#  INGEST_SECRET, SESSION_SECRET, ADMIN_USERNAME, ADMIN_PASSWORD,
#  TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY).

bind_addr: ":8080"
public_base_url: "http://localhost:8080"
db_path: "./data/email.db"
storage_dir: "./data/storage"

# Shared secret used to sign requests from the Cloudflare Worker.
# Must match the Worker's INGEST_SECRET.
ingest_secret: "change-me-ingest"

# HMAC secret for signing admin session cookies.
session_secret: "change-me-session"

# Single admin (plaintext). Edit + restart to change credentials.
admin:
  username: "admin"
  password: "changeme12"

# Optional Cloudflare Turnstile (admin login captcha).
turnstile:
  site_key: ""
  secret_key: ""
